# STEP 1: Copy this file to .env if you want to change the page title.
# STEP 2: Vite only lets React read variables that begin with VITE_.
# STEP 3: Restart npm run dev after changing the file.
# This is a PUBLIC value. Never put passwords or private keys in VITE_ values.
VITE_APP_TITLE=Class 31 To Do Lab
