# Copy to server/.env and supply YOUR OWN credentials.
PORT=3001
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/daymark_db

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS

# Set this to your Vite or deployed frontend URL.
CORS_ORIGIN=http://localhost:5173

# Optional: seeds one admin user on first start (minimum 8 character password).
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD

# For hosted databases with a trusted SSL certificate, uncomment:
# PGSSLMODE=require
